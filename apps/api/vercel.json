{
  "installCommand": "echo done",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @pashacaro/api exec tsx src/db/migrate-prod.ts",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/v1/:path*", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/v1/internal/cost-report",
      "schedule": "0 18 * * *"
    }
  ]
}
