# ローカル開発用の環境変数サンプル。
# `cp .env.example .env` してから値を設定し、`set -a && source .env && set +a` で読み込む
# (このAPIサーバーはdotenvを読み込まないため、環境変数として渡す必要がある)。
#
# Vercelにデプロイする場合は、Project Settings > Environment Variables に
# 同じキーを設定すること(PORTとPGLITE_FORCEはVercelでは不要)。

# Anthropic API キー(/v1/analyze, /v1/analyze/text に必須)
ANTHROPIC_API_KEY=

# devトークン認証用(Authorization: Bearer <DEV_TOKEN>)
DEV_TOKEN=dev-secret

# JWT署名用シークレット(/v1/auth/* に必須)。本番では長いランダム文字列に変更すること
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-prod

# Sign in with Apple / Google のクライアントID(/v1/auth/apple, /v1/auth/google で使用)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# RevenueCat Webhook検証用シークレット(/v1/webhooks/revenuecat)
REVENUECAT_WEBHOOK_SECRET=

# 日次コストレポート(/v1/internal/cost-report)を保護するシークレット。
# Vercel Cronからのリクエストを許可するため、VercelのCRON_SECRET環境変数と同じ値を設定する
INTERNAL_CRON_SECRET=

# 本番DB(Neon Postgres)接続文字列。未設定の場合はPGlite(インメモリ)にフォールバックする
DATABASE_URL=

# --- ローカル開発専用(Vercelでは設定不要) ---
PGLITE_FORCE=1
PORT=8787
